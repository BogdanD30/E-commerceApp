<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ecomm.controller.MainController"
            styleClass="app-bg" prefWidth="1280.0" prefHeight="800.0">
    <stylesheets>
        <URL value="@../css/app.css"/>
    </stylesheets>

    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="16.0">
            <Label text="E-Commerce Auto" styleClass="brand"/>
            <TextField fx:id="keywordField" promptText="Search title or description..." prefWidth="340.0"
                       onAction="#handleSearch"/>
            <Button text="Search" onAction="#handleSearch" styleClass="button-primary"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="welcomeLabel" text="Welcome!" styleClass="top-bar-text"/>
            <Button fx:id="logoutButton" text="Log out" onAction="#handleLogout" styleClass="button-ghost"/>
        </HBox>
    </top>

    <left>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" prefWidth="270.0" styleClass="filter-panel">
            <VBox spacing="12.0" styleClass="filter-panel">
                <Label text="Filters" styleClass="section-title"/>

                <VBox spacing="4.0">
                    <Label text="Make" styleClass="field-label"/>
                    <ComboBox fx:id="makeFilterComboBox" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="4.0">
                    <Label text="Model" styleClass="field-label"/>
                    <ComboBox fx:id="modelFilterComboBox" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="4.0">
                    <Label text="Body type" styleClass="field-label"/>
                    <ComboBox fx:id="bodyTypeFilterComboBox" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="4.0">
                    <Label text="Fuel" styleClass="field-label"/>
                    <ComboBox fx:id="fuelFilterComboBox" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="4.0">
                    <Label text="Price (€)" styleClass="field-label"/>
                    <HBox spacing="8.0">
                        <TextField fx:id="minPriceField" promptText="Min" HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="maxPriceField" promptText="Max" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>

                <VBox spacing="4.0">
                    <Label text="Year" styleClass="field-label"/>
                    <HBox spacing="8.0">
                        <TextField fx:id="minYearField" promptText="From" HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="maxYearField" promptText="To" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>

                <VBox spacing="4.0">
                    <Label text="Location" styleClass="field-label"/>
                    <TextField fx:id="locationSearchField" promptText="City or area"/>
                </VBox>

                <Button fx:id="searchButton" text="Apply filters" onAction="#handleSearch"
                        maxWidth="Infinity" styleClass="button-primary"/>
                <Button fx:id="clearFiltersButton" text="Clear filters" onAction="#handleClearFilters"
                        maxWidth="Infinity" styleClass="button-secondary"/>
            </VBox>
        </ScrollPane>
    </left>

    <center>
        <VBox spacing="12.0">
            <padding>
                <Insets top="16" right="16" bottom="12" left="16"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label fx:id="titleLabel" text="All listings" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="allListingsButton" text="All listings" onAction="#handleShowAllListings"
                        styleClass="button-secondary"/>
                <Button fx:id="myListingsButton" text="My listings" onAction="#handleMyListings"
                        styleClass="button-secondary"/>
                <Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh" styleClass="button-secondary"/>
            </HBox>

            <TableView fx:id="listingsTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="titleColumn" text="Title" minWidth="240.0"/>
                    <TableColumn fx:id="makeColumn" text="Make"/>
                    <TableColumn fx:id="modelColumn" text="Model"/>
                    <TableColumn fx:id="bodyTypeColumn" text="Body"/>
                    <TableColumn fx:id="yearColumn" text="Year" maxWidth="80.0"/>
                    <TableColumn fx:id="mileageColumn" text="Mileage"/>
                    <TableColumn fx:id="fuelColumn" text="Fuel"/>
                    <TableColumn fx:id="priceColumn" text="Price"/>
                    <TableColumn fx:id="locationColumn" text="Location"/>
                </columns>
            </TableView>

            <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="action-bar">
                <Button fx:id="addListingButton" text="+ Add listing" onAction="#handleAddListing"
                        styleClass="button-success"/>
                <Button fx:id="viewDetailsButton" text="View details" onAction="#handleViewDetails"
                        styleClass="button-primary"/>
                <Button fx:id="removeListingButton" text="Remove my listing" onAction="#handleRemoveListing"
                        styleClass="button-danger"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT">
            <Label fx:id="statusLabel" text="Ready" styleClass="status-text"/>
        </HBox>
    </bottom>
</BorderPane>
